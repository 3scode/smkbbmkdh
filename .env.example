# Salin ke .env.local lalu isi. JANGAN commit .env.local (sudah di .gitignore).
# File ini (.env.example) aman di-commit — berisi placeholder, bukan secret.

# --- Database ---
# Lokal (DDEV Postgres 16, host_db_port 54321 — lihat `ddev describe`):
# DATABASE_URL=postgresql://db:db@127.0.0.1:54321/db
# Production (Supabase, pooled 6543 untuk runtime; direct 5432 hanya untuk migrate):
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres
# --- Storage KK ---
# Lokal: local (simpan ke public/uploads/kk). Production di Netlify: supabase.
STORAGE_PROVIDER=local
UPLOAD_DIR=./public/uploads/kk
# --- Supabase (wajib di production, dummy saat dev lokal) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example
# SERVER ONLY — jangan pakai prefix NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-service-role
PII_ENCRYPTION_KEY=base64:REPLACE_WITH_32_RANDOM_BYTES_BASE64

# --- Auth / Admin ---
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
ADMIN_EMAIL=humas@smkbbm.sch.id
# SERVER ONLY — tanda tangan cookie sesi (HS256, min 32 char acak). Jangan commit nilainya.
AUTH_SECRET=replace-with-random-64-char-string-for-auth-cookie-signing
# Masa berlaku sesi login (jam). Default 12.
SESSION_TTL_HOURS=12

# --- Integrasi ---
RESEND_API_KEY=re_replace-with-resend-key
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_WA_NUMBER=6281234567890
# Opsional, aktifkan jika spam form >5%
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000aa
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB
SENTRY_DSN=https://example@sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://example@sentry.io/0
REVALIDATE_SECRET=replace-with-random-32-char
CRON_SECRET=replace-with-random-32-char

# --- App Config ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=https://smkbbm-kandanghaur.sch.id
NEXT_PUBLIC_APP_NAME=SMK Bangun Bangsa Mandiri Kandanghaur
IDEMPOTENCY_TTL_HOURS=24
UPLOAD_MAX_MB=2
RATE_LIMIT_PER_MIN=5
